{
  "expo": {
    "name": "Poshan AI",
    "slug": "poshan-ai",
    "scheme": "poshanai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poshanai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Poshan AI uses the camera to capture photos of your meals for AI analysis.",
        "NSPhotoLibraryUsageDescription": "Poshan AI accesses your photo library to log meal photos."
      }
    },
    "android": {
      "package": "com.poshanai.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Poshan AI uses the camera to capture photos of your meals for AI analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Poshan AI accesses your photos to log meal images."
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#16a34a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0aed009-415a-478c-9917-3cb381442217"
      },
      "privacyPolicyUrl": "https://poshanai.app/privacy"
    },
    "owner": "gnsepili"
  }
}
