{
  "expo": {
    "name": "Poshan AI",
    "slug": "poshan-ai",
    "scheme": "poshanai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["android", "ios"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poshanai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Poshan AI uses the camera to capture photos of your meals for AI analysis.",
        "NSPhotoLibraryUsageDescription": "Poshan AI accesses your photo library to log meal photos."
      }
    },
    "android": {
      "package": "com.poshanai.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Poshan AI uses the camera to capture photos of your meals for AI analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Poshan AI accesses your photos to log meal images."
        }
      ]
    ]
  }
}
